{
  "name": "sezzle-calculator-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "npm run test:core && npm run test:ui",
    "test:core": "node --experimental-strip-types --test tests/core.test.ts",
    "test:ui": "vitest run",
    "coverage:core": "node --experimental-strip-types --experimental-test-coverage --test-coverage-include=src/calculator.ts --test-coverage-include=src/api.ts --test tests/core.test.ts",
    "coverage:ui": "vitest run --coverage",
    "coverage": "npm run coverage:core && npm run coverage:ui",
    "test:live": "node --experimental-strip-types --test tests/live.test.ts"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@testing-library/dom": "10.4.1",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "@vitest/coverage-v8": "3.2.4",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "vite": "6.4.6",
    "vitest": "3.2.4"
  }
}
